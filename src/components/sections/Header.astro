---
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import { getLocaleFromUrl, localizePath, useTranslations } from '@/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const home = localizePath('/', locale);

const links = [
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#process`, label: t('nav.process') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="bg-ink-950/70 sticky top-0 z-40 border-b border-white/5 backdrop-blur-lg">
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <Logo href={home} />

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sand-300 hover:bg-brand-500 rounded-full px-4 py-2 transition hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <LanguageSwitcher />
      <Button href={`${home}#contact`} variant="light" class="px-5 py-2">
        {t('nav.cta')}
      </Button>
    </div>

    <!-- Menu mobile sem JavaScript -->
    <details class="group md:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-white/15 px-4 py-2 text-sm font-semibold">
        {t('nav.menu')}
      </summary>
      <div class="bg-ink-900 absolute inset-x-0 top-18 border-b border-white/10 p-4">
        <ul class="flex flex-col gap-1">
          {links.map((link) => (
            <li>
              <a href={link.href} class="block rounded-xl px-4 py-3 hover:bg-white/5">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex items-center justify-between px-4">
          <LanguageSwitcher />
        </div>
      </div>
    </details>
  </div>
</header>
