---
import Button from '@/components/ui/Button.astro';
import { getLocaleFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<section class="bg-glow relative overflow-hidden">
  <div class="container-page grid min-h-[calc(100dvh-4.5rem)] items-center gap-12 py-16 lg:grid-cols-[1.3fr_1fr]">
    <div>
      <h1 class="font-display text-4xl leading-[1.05] font-medium text-balance sm:text-6xl lg:text-7xl">
        {t('hero.title')}
      </h1>
      <p class="text-sand-300 mt-6 max-w-xl text-lg">{t('hero.subtitle')}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="#contact">{t('hero.cta')}</Button>
        <Button href="#projects" variant="ghost">
          {t('hero.secondary')}
        </Button>
      </div>
    </div>

    <aside class="bg-sand-50 text-ink-950 rounded-card max-w-sm justify-self-end p-6 shadow-2xl lg:rotate-2">
      <p class="font-display text-xl font-bold">{t('hero.card.title')}</p>
      <p class="text-ink-700 mt-2 text-sm">{t('hero.card.text')}</p>
      <a href="#contact" class="bg-ink-950 mt-5 inline-flex rounded-full px-5 py-2 text-xs font-semibold text-white">
        {t('hero.card.cta')}
      </a>
    </aside>
  </div>
</section>
