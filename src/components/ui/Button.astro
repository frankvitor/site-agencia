---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'light' | 'ghost';

type Props = HTMLAttributes<'a'> &
  HTMLAttributes<'button'> & {
    variant?: Variant;
    href?: string;
  };

const { variant = 'primary', href, class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-brand-gradient text-white shadow-lg shadow-brand-600/25 hover:brightness-110',
  light: 'bg-sand-50 text-ink-950 hover:bg-sand-100',
  ghost: 'border border-white/15 text-sand-50 hover:border-brand-400 hover:text-brand-300',
};

const classes = [
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition',
  variants[variant],
  className,
];
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={classes} {...rest}>
  <slot />
</Tag>
